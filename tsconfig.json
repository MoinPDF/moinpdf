{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "app/page.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "workers/**/*.ts",
    "selfhost/**/*.tsx",
    "vite*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".cache"
  ]
}
