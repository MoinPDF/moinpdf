{
  "name": "moinpdf",
  "version": "0.23.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && vite --config vite.selfhost.config.ts",
    "build": "node --experimental-strip-types scripts/build-documentation.mjs && node scripts/build-media.mjs && node scripts/build-english-pages.mjs && node scripts/prepare-pdf-assets.mjs && vite build --config vite.selfhost.config.ts && node scripts/check-worker-assets.mjs dist/selfhost && node --experimental-vm-modules tests/bundled-module-worker-smoke.mjs dist/selfhost",
    "start": "vite preview --config vite.selfhost.config.ts --host 0.0.0.0 --port 8080",
    "lint": "eslint app/page.tsx components/studio lib hooks selfhost --max-warnings 0",
    "test:pdf": "node tests/pdf-smoke.mjs",
    "test:studio": "node tests/studio-smoke.mjs",
    "test:check": "node tests/document-check-smoke.mjs",
    "test:tools": "node tests/tool-search-smoke.mjs",
    "test:editor": "node tests/editor-smoke.mjs",
    "test:extra": "node tests/extra-tools-smoke.mjs",
    "test:documents": "node tests/document-tools-smoke.mjs",
    "test:security": "node tests/security-invoice-smoke.mjs",
    "test:advanced": "node tests/advanced-tools-smoke.mjs",
    "test": "node tests/run-all.mjs",
    "build:selfhost": "node --experimental-strip-types scripts/build-documentation.mjs && node scripts/build-media.mjs && node scripts/build-english-pages.mjs && node scripts/prepare-pdf-assets.mjs && vite build --config vite.selfhost.config.ts && node scripts/build-offline.mjs dist/selfhost && node scripts/check-worker-assets.mjs dist/selfhost && node --experimental-vm-modules tests/bundled-module-worker-smoke.mjs dist/selfhost",
    "typecheck:selfhost": "tsc --project tsconfig.selfhost.json --noEmit",
    "package:pages": "pnpm run build:selfhost && node scripts/package-pages.mjs",
    "test:conversion": "node tests/conversion-smoke.mjs",
    "test:evidence": "node tests/evidence-smoke.mjs",
    "test:century": "node tests/century-smoke.mjs",
    "format": "prettier --write app/page.tsx app/globals.css \"components/studio/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"selfhost/**/*.{ts,tsx,html}\"",
    "format:check": "prettier --check app/page.tsx app/globals.css \"components/studio/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"selfhost/**/*.{ts,tsx,html}\"",
    "test:writer": "node tests/writer-smoke.mjs",
    "test:usability": "node tests/usability-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
