    "typescript-eslint": "8.71.0",
    "vinext": "1.0.0-beta.5",
    "vite": "8.3.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "description": "PDF-Arbeitsplatz mit lokaler Verarbeitung und integrierter Dokumentkonvertierung",
  "homepage": "https://moinpdf.de",
  "license": "UNLICENSED",
