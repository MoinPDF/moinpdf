{
  "name": "moinpdf",
  "version": "0.5.11",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && vite --config vite.selfhost.config.ts",
    "build": "node --experimental-strip-types scripts/build-documentation.mjs && node scripts/build-media.mjs && node scripts/prepare-pdf-assets.mjs && vite build --config vite.selfhost.config.ts",
    "start": "vite preview --config vite.selfhost.config.ts --host 0.0.0.0 --port 8080",
    "lint": "eslint app/page.tsx components/studio lib hooks selfhost",
    "test:pdf": "node tests/pdf-smoke.mjs",
    "test:studio": "node tests/studio-smoke.mjs",
    "test:check": "node tests/document-check-smoke.mjs",
    "test:tools": "node tests/tool-search-smoke.mjs",
    "test:editor": "node tests/editor-smoke.mjs",
    "test:extra": "node tests/extra-tools-smoke.mjs",
    "test:documents": "node tests/document-tools-smoke.mjs",
    "test:security": "node tests/security-invoice-smoke.mjs",
    "test:advanced": "node tests/advanced-tools-smoke.mjs",
    "test": "node tests/run-all.mjs",
    "build:selfhost": "node --experimental-strip-types scripts/build-documentation.mjs && node scripts/build-media.mjs && node scripts/prepare-pdf-assets.mjs && vite build --config vite.selfhost.config.ts",
    "typecheck:selfhost": "tsc --project tsconfig.selfhost.json --noEmit",
    "package:pages": "pnpm run build:selfhost && node scripts/package-pages.mjs",
    "test:conversion": "node tests/conversion-smoke.mjs",
    "test:evidence": "node tests/evidence-smoke.mjs",
    "test:century": "node tests/century-smoke.mjs",
    "format": "prettier --write app/page.tsx app/globals.css \"components/studio/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"selfhost/**/*.{ts,tsx,html}\"",
    "format:check": "prettier --check app/page.tsx app/globals.css \"components/studio/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"selfhost/**/*.{ts,tsx,html}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bwip-js/browser": "^4.11.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "^0.3.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.9.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "PDF-Arbeitsplatz mit lokaler Verarbeitung und integrierter Dokumentkonvertierung",
  "homepage": "https://moinpdf.de",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennysubke/moinpdf.git"
  },
  "bugs": {
    "email": "ahoi@moinpdf.de"
  }
}
