# Optional: defaults work without this file. Copy to .env to customize.
MOINPDF_PORT=8080
MOINPDF_BIND=0.0.0.0

# Optional login for the entire app and its API. Use HTTPS for remote access.
MOINPDF_USERNAME=moinpdf
MOINPDF_PASSWORD=

# Only used with compose.https.yaml; DNS must point to your server.
MOINPDF_DOMAIN=

# Optional container memory limits; allow additional RAM for the host/build.
MOINPDF_DOCUMENT_MEMORY=2g
MOINPDF_TRANSLATION_MEMORY=4g
MOINPDF_WEBSITE_MEMORY=1g

# Optional operator-funded DATEV posting suggestions. Personal keys are entered in the tool. Copy to .env on the host only.
# OPENAI_API_KEY=         # personal OpenAI API key, used only by the backend
# MOINPDF_DATEV_ACCESS_TOKEN=  # separate private random access code, at least 20 characters
# OPENAI_MODEL=gpt-5-mini
