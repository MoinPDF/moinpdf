MOINPDF_DOMAIN=pdf-server.example.de
MOINPDF_ORIGINS=https://moinpdf.de
MOINPDF_API_KEY=HIER_EINEN_EIGENEN_ZUFAELLIGEN_SCHLUESSEL_EINTRAGEN

# Optional: eigener LibreTranslate-Dienst im internen Dokumentennetz
MOINPDF_TRANSLATE_URL=
MOINPDF_TRANSLATE_KEY=

# Optional: konfigurierter HTTPS-Zeitstempeldienst im kontrollierten Netz.
# Vertrauensanker als PEM unter trust/, CRL/OCSP als DER unter trust/revocation/.
# Die interne Netzisolation bleibt erhalten; Betreiber richtet gezielte Erreichbarkeit ein.
MOINPDF_TSA_URL=
MOINPDF_TSA_BEARER=
